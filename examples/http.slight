;
;  /*
;
;  This is a simple syncronous HTTP client meaning it must complete the
;  full request/response cycle before starting another one.
;
;  It implements request/response queueing to enforce the order of processing
;  using the `defer` keyword.
;
;  This means that when the first request is sent to the client it enters
;  the response waiting period during which it will queue any future HTTP
;  requests. When it receives the response it returns to the request waiting
;  state where it will pick up the next request in the queue.
;
;  */
;
;  machine HTTPClient {
;
;      var user   : User;
;      var server : HTTPServer;
;
;      start state Init {
;          entry (u : User, s : HTTPServer) {
;              user   = u;
;              server = s;
;              goto WaitForRequest;
;          }
;      }
;
;      state WaitForRequest {
;          defer eHTTPResponse; // defer to process in order
;
;          on eHTTPRequest do (req : HTTPRequest) {
;              send server, eHTTPConnectionRequest, (from = this, request = req);
;              goto WaitForResponse;
;          }
;      }
;
;      state WaitForResponse {
;          defer eHTTPRequest; // defer to process in order
;
;          on eHTTPResponse do (response : HTTPResponse) {
;              send user, eHTTPResponse, response;
;              goto WaitForRequest;
;          }
;      }
;
;  }
;
;  machine User {
;      var server  : HTTPServer;
;      var client  : HTTPClient;
;      var request : HTTPRequest;
;
;      start state Init {
;          entry () {
;              server  = new HTTPServer();
;              client  = new HTTPClient(this, server);
;              request = (method = GET, uri = "/");
;              send client, eHTTPRequest, request;
;              receive {
;                  case eHTTPResponse: (response : HTTPResponse) {
;                      print format ("STATUS: {0}", response.status);
;                      print format ("BODY:\n{0}", response.content.body);
;                  }
;              }
;          }
;      }
;  }
;
