
(defun Screen (rows cols line-no line-len)
    (lambda (m)
        (case m
            (:rows       rows)
            (:cols       cols)
            (:line-no    line-no)
            (:line-len   line-len)
            (:atBottom?  (>= line-no rows))
            (:lineCursor (lambda (line) (Cursor line-no 0 rows (max (str-len line) cols)))))))

(defun Cursor (row col max-row max-col)
    (lambda (m)
        (case m
            (:row row)
            (:col col)
            (:nextLine  (Cursor (inc row) col))

            (:canMoveUp    (> row 0))
            (:canMoveDown  (< row max-row))
            (:canMoveLeft  (> col 0))
            (:canMoveRight (< col max-col))

            (:moveUp    (Cursor (if (== row 0)       row (dec row)) col max-row max-col))
            (:moveDown  (Cursor (if (== row max-row) row (inc row)) col max-row max-col))
            (:moveLeft  (Cursor row (if (== col 0)       col (dec col)) max-row max-col))
            (:moveRight (Cursor row (if (== col max-col) col (inc col)) max-row max-col))
        ))

(defun Buffer (source)
    (let len (length source))
    (lambda (m)
        (case m
            (:source source)
            (:length len)
            (:next   (car source))
            (:rest   (if (nil? (cdr source)) () (Buffer (cdr source)))))))

(defun EditorCmd (cursor handler)
    (lambda (m)
        (case m
            (:line-no (cursor :row))
            (:handler handler))))

(defun InsertCharAt (cursor char)
    (EditorCmd cursor (lambda (line) (str-splice-at line (cursor :col) char))))

(defun DeleteCharAt (cursor)
    (EditorCmd cursor (lambda (line) (str-splice-at line (cursor :col) ()))))

(defun refresh-screen (screen buffer cursor acc cmd)
    (case #true
        ;; we have reached the end of the screen
        ((screen :atBottom?) (reverse acc))
        ;; our buffer has run out ...
        ((nil? buffer)
            (tty/write "~" \e "[K" \r \n)
            (refresh-screen screen buffer (cursor :nextLine) acc))
        ;; otherwise print the buffer ...
        (#true
            (let next
                ;; if we have a cmd ... and we are on the right line number
                (if (or (nil? cmd) (!= (cmd :line-no) (cursor :row)))
                    (buffer :next)
                    ((cmd :handler) (buffer :next))))
            (tty/write next \e "[K" \r \n)
            (refresh-screen screen (buffer :rest) (cursor :nextLine) (cons next acc)))))

(defun Editor (screen buffer cmd)
    ;; ... refresh the screen
    (let edited (refresh-screen screen buffer (screen :blankCursor) () cmd))

    (let current-line
        (if (>= (cursor :row) (buffer :length))
            "~"
            (nth (cursor :row) buffer)))

    (let cursor ((screen :lineCursor) current-line))

    (let key (recv))
    (case (car key)
        ;; insert newline
        (\r
            (list cursor ()))
        ;; move the cursor
        (:ArrowUp
            (list cursor ()))
        (:ArrowDown
            (list cursor ()))
        (:ArrowLeft
            (list cursor ()))
        (:ArrowRight
            (list cursor ()))
        ;; delete the character
        (:Backspace
            (list cursor ()))
        ;; insert the character
        (#true
            (list cursor ()))
    )
)


(defun init-editor (source)
    (let rows (tty/screen/rows))
    (let cols (tty/screen/cols))
    (connect :keypress
        (Editor
            (Screen rows cols 0)
            (Buffer source)
            ()
        )
    ))


(let e (init-editor (list
    "line 1"
    "line 2 ... this is the second line"
    "line 3"
    "line 4"
    "line 5 ... look 5 lines now"
    "line 6"
    "line 7"
    "line 8 ... this is the last line"
)))


(join e)
