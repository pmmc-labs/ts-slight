
(defun KeyCatcher ()
    (let key (recv))
    (case (car key)
        ("q"   (pprint "goodbye"))
        (#true
            (pprint key)
            (KeyCatcher))))


(let keyboard (connect :keypress (KeyCatcher)))

(send keyboard (list "h"))
(send keyboard (list "e"))
(send keyboard (list "l"))
(send keyboard (list "l"))
(send keyboard (list "o"))

(send keyboard (list "q"))

(join keyboard)
