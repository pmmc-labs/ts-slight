

(defun Editor (h w config)
    (let cx          (car config))
    (let cy          (cadr config))
    (let line-buffer (car (cddr config)))

    (tty/write
        \e "[?25l"  ; hide cursor
        \e "[H")    ; home cursor

    ;; draw the lines
    (do-times 0 h (lambda (i)
        (tty/write
            "~"        ; the line
            \e "[K"    ; clear whatever remains
            \r \n )))  ; put in the line break

    (tty/write ; position cursor at cx/cy
        \e "[" (+ cy 1) ";" (+ cx 1) "H"
        \e "[?25h") ; show cursor again

    (let key (recv))
    (Editor h w
        (case (car key)
            (:ArrowUp
                (list cx (dec cy) line-buffer))
            (:ArrowDown
                (list cx (inc cy) line-buffer))
            (:ArrowLeft
                (list (dec cx) cy line-buffer))
            (:ArrowRight
                (list (inc cx) cy line-buffer))
            (#true
                (pprint key)
                (tty/write key))))
)


(let editor (connect
    :keypress
        (Editor
            (tty/screen/rows)
            (tty/screen/cols)
            (list 0 0 ()))
    )
)

(join editor)

