
;; -----------------------------------------------------------------------------

(defun build-grid-row (size init-cell start)
    (if (< size 0) start
        (build-grid-row (- size 1) init-cell (cons (init-cell size) start))))

(defun init-grid (size init-cell)
    (let h (- size 1))
    (let w (- size 1))
    (list
        (- size 1)
        (build-grid-row h (lambda (x)
            (build-grid-row w (lambda (y)
                (init-cell x y))
                    ())) ())))

(defun grid-size  (grid) (car grid))
(defun grid-board (grid) (cadr grid))

(defun wrap-around (n max)
    (if (< n 0) (+ max n) (if (> n max) (- n max) n )))

(defun grid-cell-at (x y grid)
    (let max (grid-size grid))
    (nth (wrap-around y max) (nth (wrap-around x max) (grid-board grid))))


;; -----------------------------------------------------------------------------

(defun init-grid-cell (x y)
    (list x y (if (== (rand 2) 0) :DEAD :LIVE )))

(defun all-directions () (list :N :NE :E :SE :S :SW :W :NW))

(defun get-neighbor-cell-for-direction (cell dir grid)
    (let x (car  cell))
    (let y (cadr cell))
    (case dir
        (:N  (grid-cell-at (dec x)      y  grid))
        (:NE (grid-cell-at (dec x) (inc y) grid))
        (:E  (grid-cell-at      x  (inc y) grid))
        (:SE (grid-cell-at (inc x) (inc y) grid))
        (:S  (grid-cell-at (inc x)      y  grid))
        (:SW (grid-cell-at (inc x) (dec y) grid))
        (:W  (grid-cell-at      x  (dec y) grid))
        (:NW (grid-cell-at (dec x) (dec y) grid))))

(defun get-cell-neighbors (cell grid)
    (map (lambda (d)
        (get-neighbor-cell-for-direction cell d grid))
            (all-directions)))

;; -----------------------------------------------------------------------------

(defun apply-rules (cell n)
    (list
        (car  cell)
        (cadr cell)
        (case (car (cddr cell))
            (:LIVE
                (cond
                    ((< n 2) :DEAD)
                    ((> n 3) :DEAD)
                    (#true   :LIVE)))
            (:DEAD
                (if (== n 3) :LIVE :DEAD)))))

(defun count-living-neighbors (neighbors)
    (reduce 0 (lambda (acc neighbor)
        (if (eq? (nth 2 neighbor) :LIVE) (+ acc 1) acc ))
            neighbors))

(defun tick (grid)
    (list
        (grid-size grid)
        (map (lambda (row)
            (map (lambda (cell)
                (apply-rules
                    cell
                    (count-living-neighbors
                        (get-cell-neighbors cell grid))))
            row))
        (grid-board grid))))

(defun display-grid (grid gen)
    (sys/io/print-ln "generation :" gen)
    (map (lambda (r)
        (sys/io/print-ln (map (lambda (c)
            (if (eq? (car (cddr c)) :LIVE) :X :O)
        ) r)))
    (grid-board grid)))

(defun run-n-generations (n grid gen)
    (if (== n 0) grid
        (do
            (display-grid grid gen)
            (run-n-generations (- n 1) (tick grid) (+ gen 1)))))


(let grid (init-grid 10 init-grid-cell))
(run-n-generations 10 grid 0)





