
(defun KeyCatcher ()
    (let key (recv))
    (case key
        ("q"   (pprint "goodbye"))
        (#true
            (pprint key)
            (KeyCatcher))))


(let keyboard (connect :keypress (KeyCatcher)))

;; simulate the user typing ...
(send keyboard "h")
(send keyboard "e")
(send keyboard "l")
(send keyboard "l")
(send keyboard "o")
;; simualte the user quitting
(send keyboard "q")

;; wait for it to exit
(join keyboard)
