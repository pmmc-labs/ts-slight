(let ^BOLD      1)
(let ^FAINT     2)
(let ^ITALIC    3)
(let ^UNDERLINE 4)
(let ^INVERT    7)
(let ^HIDE      8)
(let ^STRIKE    9)

(defun Style (fg-color bg-color styles)
    (lambda (contents)
        (concat
            \e "["
            (str-join ";" (append
                styles
                (append
                    (cons 38 (cons 2 fg-color))
                    (cons 48 (cons 2 bg-color)))))
            ";m"
            contents
            \e "[0m")))


(defun Cell (width align pad-char style)
    (lambda (content)
        (let len (str-len content))
        (style
            (if (== width len) content
            (if (<  width len) (substring content 0 width)
            (if (>  width len) (do
                (let pad (str-repeat pad-char (- width len)))
                (case align
                    (:LEFT   (~ content pad))
                    (:RIGHT  (~ pad content))
                    (:CENTER
                        (let w   (/ (- width len) 2))
                        (let lhs (str-repeat pad-char (ceil  w )))
                        (let rhs (str-repeat pad-char (floor w )))
                        (concat lhs content rhs))))
                        ()))))))

(let s1 (Style (lookup-color :armyGreen)    (lookup-color :artichoke)  (list ^ITALIC )))
(let s2 (Style (lookup-color :sapphireBlue) (lookup-color :neonCarrot) (list ^BOLD   )))

(let c1 (Cell 20 :LEFT  " " s1))
(let c2 (Cell 30 :RIGHT "." s2))

(tty/write (c1 "Hello World")   \n)
(tty/write (c2 "Goodbye World") \n)
(tty/write (c1 "Again??")       \n)







