
(pprint "AND tests ...")

(pprint (and #true        "ok"))
(pprint (and #false       "not ok"))
(pprint (and ()           "not ok"))
(pprint (and 10           "ok"))
(pprint (and (list 1 2 3) "ok"))

(pprint "OR tests ...")

(pprint (or #true        "not ok"))
(pprint (or #false       "ok"))
(pprint (or ()           "ok"))
(pprint (or 10           "not ok"))
(pprint (or (list 1 2 3) "not ok"))

(pprint "NOT tests ...")

(pprint (not #true))
(pprint (not #false))




