
(defun test-actor (next)
    ;(sys/io/print-ln "ACTOR READY! " $$ " with next " next)
    (let msg (recv))
    (let count (cadr msg))
    (if (nil? next)
        (do
            (time-it/end "start")
            (sys/io/print-ln "ALL DONE: " count " at " $$))
        (do
            ;(sys/io/print-ln "!! Sending Ping to " next " from " $$ " with count " count)
            (send next (list 'PING (+ count 1))))
    )
)

(defun setup (n next)
    (if (== n 0)
        (do
            (sys/io/print-ln "READY")
            next)
        (setup (- n 1) (fork (test-actor next)))))

(let actor-count 100000)

(sys/io/print-ln "INIT with " actor-count " actors")
(time-it "setup")
(let last (setup actor-count (fork (yield (test-actor ())))))
(time-it/end "setup")

(sys/io/print-ln "START")
(time-it "start")
(send last (list 'PING 0))

;; -----------------------------------------------------------------------------
;; Timings, env refactor 2026-07-13 (compiled js, 1M actors)
;; -----------------------------------------------------------------------------
;;
;; before : setup 3.673s | start 3.949s | slight-run 7.626s
;; after  : setup 3.469s | start 3.722s | slight-run 7.196s
;;
;; 5M actors on the default (~4GB) heap: still OOMs after the refactor
;; (footprint is smaller, but not enough) -- needs --max-old-space-size=8192.
;;
;; -----------------------------------------------------------------------------

