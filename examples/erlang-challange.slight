
(defun test-actor (next)
    ;(sys/io/print-ln "ACTOR READY! " $$ " with next " next)
    (let msg (recv))
    (let count (cadr msg))
    (if (nil? next)
        (do
            (time-it/end "start")
            (sys/io/print-ln "ALL DONE: " count " at " $$))
        (do
            ;;(sys/io/print-ln "!! Sending Ping to " next " from " $$ " with count " count)
            (send next (list 'PING (+ count 1))))
    )
)

(defun setup (n next)
    (if (== n 0)
        (do
            (sys/io/print-ln "READY")
            next)
        (setup (- n 1) (fork (yield (test-actor next))))))

(let actor-count 5000000)

(sys/io/print-ln "INIT with " actor-count " actors")
(time-it "setup")
(let last (setup actor-count (fork (yield (test-actor ())))))
(time-it/end "setup")

(sys/io/print-ln "START")
(time-it "start")
(send last (list 'PING 0))


