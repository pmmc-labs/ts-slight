;; -----------------------------------------------------------------------------
;; Begin Prelude
;; -----------------------------------------------------------------------------

(defun inc (n) (+ n 1))
(defun dec (n) (- n 1))

(defun do-times (start end f)
    (if (>= start end) ()
        (do (f start) (do-times (+ start 1) end f))))

;; -----------------------------------------------------------------------------
;; List functions
;; -----------------------------------------------------------------------------

(defun length (lst)
    (if (nil? lst) 0
        (+ 1 (length (tail lst)))))

(defun nth (i lst)
    (if (nil? lst) ()
        (if (== i 0)
            (head lst)
            (nth (- i 1) (tail lst)))))

(defun map (f lst)
    (if (nil? lst) ()
        (cons (f (head lst)) (map f (tail lst)))))

(defun grep (f lst)
    (if (nil? lst) ()
        (if (f (head lst))
            (cons (head lst) (grep f (tail lst)))
            (grep f (tail lst)))))

(defun find (f lst)
    (when (not (nil? lst))
        (if (f (head lst)) (head lst)
            (find f (tail lst)))))

(defun reduce (acc f lst)
    (if (nil? lst) acc
        (reduce (f acc (head lst)) f (tail lst))))

;; for lists of numbers ...

(defun range (start end step)
    (if (>= start end)
        (cons end ())
        (cons start (range (+ start step) end step))))

(defun sum (lst)
    (reduce 0 (lambda (acc n) (+ acc n)) lst))

(defun product (lst)
    (reduce 1 (lambda (acc n) (* acc n)) lst))

;; -----------------------------------------------------------------------------
;; System functions
;; -----------------------------------------------------------------------------

(defun sleep (ms) (syscall 'sleep ms))

;; -----------------------------------------------------------------------------
;; End Prelude
;; -----------------------------------------------------------------------------
