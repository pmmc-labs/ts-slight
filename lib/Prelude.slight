;; -----------------------------------------------------------------------------
;; Begin Prelude
;; -----------------------------------------------------------------------------

;; -----------------------------------------------------------------------------
;; List constructors
;; -----------------------------------------------------------------------------

(defun range (b e)
    (if (== b e)
        (cons e ())
        (cons b (range (+ b 1) e))))

;; -----------------------------------------------------------------------------
;; List functions
;; -----------------------------------------------------------------------------

(defun length (lst)
    (if (nil? lst) 0
        (+ 1 (length (tail lst)))))

(defun map (f lst)
    (if (nil? lst) ()
        (cons (f (head lst)) (map f (tail lst)))))

(defun grep (f lst)
    (if (nil? lst) ()
        (if (f (head lst))
            (cons (head lst) (grep f (tail lst)))
            (grep f (tail lst)))))

(defun find (f lst)
    (when (not (nil? lst))
        (if (f (head lst)) (head lst)
            (find f (tail lst)))))

(defun reduce (acc f lst)
    (if (nil? lst) acc
        (reduce (f (head lst) acc) f (tail lst))))

;; for lists of numbers ...

(defun sum (lst)
    (reduce 0 (lambda (n acc) (+ acc n)) lst))

(defun product (lst)
    (reduce 1 (lambda (n acc) (* acc n)) lst))

(defun max (lst)
    (reduce 0 (lambda (n acc) (max acc n)) lst))

(defun min (lst)
    (reduce 0 (lambda (n acc) (min acc n)) lst))

;; -----------------------------------------------------------------------------
;; System functions
;; -----------------------------------------------------------------------------

(defun sleep (ms) (syscall 'sleep ms))

;; -----------------------------------------------------------------------------
;; End Prelude
;; -----------------------------------------------------------------------------
