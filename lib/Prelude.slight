;; -----------------------------------------------------------------------------
;; Begin Prelude
;; -----------------------------------------------------------------------------

(defun inc (n) (+ n 1))
(defun dec (n) (- n 1))

(defun do-times (start end f)
    (if (>= start end) ()
        (do (f start) (do-times (+ start 1) end f))))

;; -----------------------------------------------------------------------------
;; List functions
;; -----------------------------------------------------------------------------

(defun length (lst)
    (fold/l 0 (lambda (acc x) (inc acc)) lst))

(defun reverse (lst)
    (fold/l () (lambda (acc x) (cons x acc)) lst))

(defun sum (lst)
    (fold/l 0 (lambda (acc n) (+ acc n)) lst))

(defun product (lst)
    (fold/l 1 (lambda (acc n) (* acc n)) lst))

(defun map (f lst)
    (fold/r () (lambda (x acc) (cons (f x) acc)) lst))

(defun grep (f lst)
    (fold/r () (lambda (x acc) (if (true? (f x)) (cons x acc) acc)) lst))

(defun filter (f lst)
    (fold/r () (lambda (x acc) (if (false? (f x)) (cons x acc) acc)) lst))

(defun nth (i lst)
    (if (nil? lst) ()
        (if (== i 0)
            (head lst)
            (nth (- i 1) (tail lst)))))

(defun find (f lst)
    (when (not (nil? lst))
        (if (f (head lst)) (head lst)
            (find f (tail lst)))))

(defun range (start end step)
    (if (>= start end)
        (cons end ())
        (cons start (range (+ start step) end step))))

;; -----------------------------------------------------------------------------
;; System functions
;; -----------------------------------------------------------------------------

(defun sleep (ms) (syscall 'sleep ms))

;; -----------------------------------------------------------------------------
;; End Prelude
;; -----------------------------------------------------------------------------
